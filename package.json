{
	"name": "code-block-pro",
	"version": "0.1.0",
	"description": "Code Block Pro - Beautiful syntax highlighting",
	"author": "Kevin Batdorf",
	"license": "GPL-2.0-or-later",
	"main": "build/index.js",
	"scripts": {
		"build": "wp-scripts build",
		"format": "oxfmt",
		"lint": "oxfmt --check && oxlint",
		"lint:fix": "oxlint --fix && oxfmt",
		"packages-update": "wp-scripts packages-update",
		"plugin-zip": "wp-scripts plugin-zip",
		"start": "wp-scripts start",
		"start:hot": "wp-scripts start --hot",
		"test:e2e": "node scripts/run-e2e.mjs",
		"test:e2e:screens": "scripts/e2e-screens.sh",
		"test:e2e:screens:update": "CAPTURE_BASELINE=1 scripts/e2e-screens.sh -g 'looks the same' --update-snapshots=all"
	},
	"devDependencies": {
		"@playwright/test": "1.64.1",
		"@types/node": "24.19.2",
		"@types/react": "18.3.28",
		"@types/wordpress__block-editor": "15.0.5",
		"@wordpress/e2e-test-utils-playwright": "3.0.0",
		"@wordpress/scripts": "36.1.0",
		"@wp-playground/cli": "3.1.58",
		"copy-webpack-plugin": "14.0.0",
		"oxfmt": "0.73.0",
		"oxlint": "1.88.0",
		"oxlint-plugin-react-doctor": "0.9.18",
		"oxlint-tsgolint": "7.0.2004",
		"typescript": "7.0.2"
	},
	"dependencies": {
		"@wordpress/api-fetch": "7.43.0",
		"@wordpress/html-entities": "4.43.0",
		"@wordpress/i18n": "6.16.0"
	}
}
