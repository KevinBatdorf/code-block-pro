{
	"compilerOptions": {
		"target": "esnext",
		"lib": ["dom", "dom.iterable", "esnext"],
		"allowJs": true,
		"skipLibCheck": true,
		"strict": true,
		"forceConsistentCasingInFileNames": true,
		"noEmit": true,
		"esModuleInterop": true,
		"module": "esnext",
		"moduleResolution": "bundler",
		"resolveJsonModule": true,
		"isolatedModules": true,
		"jsx": "preserve",
		"types": ["node"],
		"incremental": true
	},
	"include": [
		"src/**/*.ts",
		"src/**/*.tsx",
		"src/front/front.js",
		"playwright.config.ts",
		"tests/**/*.ts"
	],
	"exclude": ["node_modules"]
}
