{
	"name": "kevinbatdorf/code-block-pro",
	"description": "Code highlighting powered by the VS Code engine",
	"license": "GPL-2.0-or-later",
	"type": "wordpress-plugin",
	"version": "dev-main",
	"require": {
		"php": ">=8.2",
		"phiki/phiki": "^2.2"
	},
	"replace": {
		"psr/simple-cache": "*"
	},
	"config": {
		"platform": {
			"php": "8.2"
		},
		"optimize-autoloader": true,
		"platform-check": false
	},
	"scripts": {
		"test": "tools/vendor/bin/phpunit",
		"phpstan": "tools/vendor/bin/phpstan analyse --memory-limit=1G",
		"lint": "tools/vendor/bin/pint --test",
		"format": "tools/vendor/bin/pint"
	}
}
